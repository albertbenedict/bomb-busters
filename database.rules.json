{
  "rules": {
    "sessions": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['status', 'config', 'public', 'hands'])",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|in_progress|won|lost)$/)"
        },
        "config": {
          ".validate": "newData.hasChildren(['wireCount', 'detonatorMax', 'yellowCount', 'redCount'])",
          "wireCount": { ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 12" },
          "detonatorMax": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "yellowCount": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6 && newData.val() % 2 == 0" },
          "redCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" }
        },
        "turnOrder": { ".validate": "newData.hasChildren() == false || newData.val() != null" },
        "currentTurn": { ".validate": true },
        "pendingGuess": { ".validate": true },
        "lastOutcome": { ".validate": true },
        "public": {
          ".validate": "newData.hasChildren(['detonator', 'players'])",
          "detonator": {
            "position": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "max": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
            "$other": { ".validate": false }
          },
          "players": {
            "$pid": {
              ".validate": "newData.hasChildren(['name'])",
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
              "wireCount": { ".validate": "newData.isNumber()" },
              "connected": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },
          "cutLog": { ".validate": true },
          "infoTokens": { ".validate": true },
          "validationTokens": { ".validate": true },
          "$other": { ".validate": false }
        },
        "hands": { ".validate": true }
      }
    },
    ".read": false,
    ".write": false
  }
}
